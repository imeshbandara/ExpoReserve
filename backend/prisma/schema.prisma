generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STALL_VENDOR
  EXHIBITION_ORGANIZER
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StallType {
  STANDARD
  PREMIUM
  CORNER
}

enum StallSize {
  SMALL
  MEDIUM
  LARGE
}

model User {
  id           String   @id @default(uuid())
  oidc_sub     String   @unique
  username     String   @unique
  email        String   @unique
  name         String
  phone        String?
  organization_name String?
  avatar_url   String?
  role         Role     @default(STALL_VENDOR)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  reservations Reservation[]
  organized_exhibitions Exhibition[]
  audit_logs AuditLog[]

  @@map("users")
}

model Exhibition {
  id            String   @id @default(uuid())
  name          String
  description   String?
  venue         String
  start_date    DateTime
  end_date      DateTime
  organizer_id  String
  organizer     User     @relation(fields: [organizer_id], references: [id], onDelete: Cascade)
  max_stalls    Int      @default(100)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  reservations Reservation[]
  stall_inventory StallInventory[]

  @@map("exhibitions")
}

model Reservation {
  id                    String   @id @default(uuid())
  vendor_id             String
  vendor                User     @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  exhibition_id         String
  exhibition            Exhibition @relation(fields: [exhibition_id], references: [id], onDelete: Cascade)
  reservation_date      DateTime
  stall_type            StallType
  stall_size            StallSize
  quantity              Int      @default(1)
  business_category     String
  special_requirements  String?
  status                ReservationStatus @default(PENDING)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([vendor_id, exhibition_id])
  @@map("reservations")
}

model StallInventory {
  id                String   @id @default(uuid())
  exhibition_id     String
  exhibition        Exhibition @relation(fields: [exhibition_id], references: [id], onDelete: Cascade)
  stall_type        StallType
  stall_size        StallSize
  total_count       Int
  reserved_count    Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@unique([exhibition_id, stall_type, stall_size])
  @@map("stall_inventory")
}

model AuditLog {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  action      String   // LOGIN, CREATE_RESERVATION, APPROVE_RESERVATION, etc.
  resource    String   // users, reservations, exhibitions
  resource_id String?
  ip_address  String?
  user_agent  String?
  status      String   // SUCCESS, FAILURE
  details     String?  // JSON details
  created_at  DateTime @default(now())

  @@map("audit_logs")
}